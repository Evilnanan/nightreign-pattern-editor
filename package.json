{
  "name": "nightreign-pattern-editor",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-locales.mjs && vite --host 127.0.0.1 --port 1420",
    "build": "node scripts/check-locales.mjs && tsc && vite build",
    "check:locales": "node scripts/check-locales.mjs",
    "locales:generate": "node scripts/check-locales.mjs --write",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "node --test tests/*.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "intl-messageformat": "^12.1.2"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
